# Copier en .env.local puis remplir les valeurs.
# cp .env.local.example .env.local

# ── Back-office /admin ──────────────────────────────────────
ADMIN_PASSWORD=changez-moi-mot-de-passe-long

# ── WooCommerce (clés REST seulement) ───────────────────────
# Courses : gérées dans WordPress.
WC_URL=https://ton-wordpress-f1.wpcomstaging.com
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx

# ── Import courses (scripts/) ───────────────────────────────
WOO_STOCK_UPPER=120
WOO_STOCK_LOWER=80
WOO_STOCK_CLUB=40

# ── Site billetterie ────────────────────────────────────────
SITE_URL=https://www.formula1tickets.example
NEXT_PUBLIC_SITE_URL=https://www.formula1tickets.example
SITE_NAME=Formula 1 Tickets
SITE_LABEL=F1

# ── E-mails (Brevo) ─────────────────────────────────────────
BREVO_API_KEY=
MAIL_FROM=Formula 1 Tickets <billets@formula1tickets.example>
MAIL_LOGO=
MAIL_QR=
CONTACT_EMAIL=support@formula1tickets.example

# ── Notifications Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Meta Conversions API (optionnel) ────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# ── Billetterie ─────────────────────────────────────────────
NEXT_PUBLIC_CART_RESERVATION_SECONDS=600
NEXT_PUBLIC_MAX_TICKETS_PER_ORDER=6
QUEUE_MIN_MS=2000
QUEUE_MAX_MS=2000

# ── Cron ────────────────────────────────────────────────────
CRON_SECRET=
